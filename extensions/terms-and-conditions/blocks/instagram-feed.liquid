{{ 'instagram-feed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'instagram-feed.js' | asset_url }}" defer></script>

{%- capture tg_style -%}
  padding-top: {{ block.settings.padding_top }}px;
  padding-bottom: {{ block.settings.padding_bottom }}px;
  --tg-if-max: {{ block.settings.max_width }}px;
  {%- if block.settings.text_color != blank %} --tg-if-text: {{ block.settings.text_color }};{% endif -%}
  {%- if block.settings.background != blank %} --tg-if-bg: {{ block.settings.background }};{% endif -%}
{%- endcapture -%}

<div
  class="tg-instafeed tg-if-align-{{ block.settings.alignment }}"
  id="tg-instafeed-{{ block.id }}"
  data-tg-instafeed
  data-heading="{{ block.settings.heading | escape }}"
  style="{{ tg_style | strip_newlines }}"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Instagram Feed",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the feed title set in the app."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "background", "label": "Section background" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
